# ───────────────────────────────────────────────────────────────
# Aammii Tharcharbu Santhai — Environment Variables (example)
# Copy to `.env` and fill in real values. Never commit `.env`.
# ───────────────────────────────────────────────────────────────

# Flask
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# Server
HOST=0.0.0.0
PORT=5000

# Admin token — required header `X-Admin-Token` for mutating endpoints
ADMIN_TOKEN=replace-with-a-strong-random-token

# CORS — comma-separated list of allowed origins (no spaces).
# Use `*` only for local dev. Example: https://aammii.com,https://www.aammii.com
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Razorpay (optional — used by /api/payment/* if you wire it up)
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_SECRET

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/aammii.log
